#include <iostream>
#include<queue>
using namespace std;
class Node{
    public:
    int data;
    Node*left;
    Node*right;
    Node(int x){
        data=x;
        left=NULL;
        right=NULL;
    }
};
Node* insert(int x , Node* root){
    Node*temp=root;
    if(temp==NULL){
        return new Node(x);
    }
    if(temp->data >x){
        temp->left=insert(x,temp->left);
    }
    else if(temp->data < x){
        temp->right=insert(x,temp->right);
    }
    return temp;
}
Node* search(int x , Node*root){
    if(root==NULL || root->data ==x ){return root;}
    if(root->data < x) {
        return search( x, root->right );
    }
    if(root->data > x) {
        return search( x, root->left );
    }
    return root;
}
Node*min(Node* root){
    if (root==NULL) return NULL;
    Node*temp=root;
    while(temp->left !=NULL){
        temp=temp->left;
    }
    return temp;
}
Node*inordersuccessor(int x ,Node*root){
    Node*temp=search(x,root);
    if(temp->right !=NULL){ return min(temp->right);}
    else{
        Node*succ=NULL;
        Node*t=root;
        while(t!=NULL){
            if(t->data > x){
                succ=t;
                t=t->left;
            }
            else if(t->data < x){
                t=t->right;
            }
            else{
                break;
            }
            
        }
        return succ;
    }
}
Node*del(int x, Node*root){
    if(root==NULL) return root;
        if(root->data > x){
            root->left=del(x,root->left);
        }
        else if(root->data < x){
            root->right=del(x,root->right);
        }
        else{
            if(root->left == NULL){
                Node*temp=root->right;
                delete root;
                return temp;
            }
            else if(root->right == NULL){
                Node*temp=root->left;
                delete root;
                return temp;
            }
            else{
                Node*temp=min(root->right);
                root->data=temp->data;
                root->right=del(temp->data,root->right);
            }
        }
        
    return root;
}
int maxdepth(Node*root){
    if(root==NULL){return 0;}
    int level=0;
    queue<Node*>q;
    q.push(root);
    q.push(NULL);
    while(!q.empty()){
        Node*temp=q.front();
        q.pop();
        if(temp==NULL){
            level++;
        
            if (!q.empty()) q.push(NULL);
        }
        else{
        
            if(temp->left) q.push(temp->left);
            if(temp->right) q.push(temp->right);
        }
    }
    return level;
}
int mindepth( Node*root){
    if(root==NULL){
        return 0;
    }

    if(root->left == NULL) return 1 + mindepth(root->right);

    if(root->right == NULL) return 1 + mindepth(root->left);

    return 1 + min(mindepth(root->left), mindepth(root->right));
}


int main() {
    Node*root=NULL;
    root=insert(10,root);
    root=insert(5,root);
    root=insert(20,root);
    root=insert(9,root);
    root=insert(15,root);
    cout<<"Max depth before deletion: "<<maxdepth(root)<<endl;
    root=del(10,root);
    root=del(5,root);
    cout<<"Max depth after deletion: "<<maxdepth(root)<<endl;
    cout<<"Min depth: "<<mindepth(root)<<endl;
    
    return 0;
}
